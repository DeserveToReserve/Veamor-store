---
import type { Lang } from '../i18n/ui';
import { h } from '../i18n/home';
const { lang } = Astro.props as { lang: Lang };
const tr = h(lang);
const items = ['faq.1', 'faq.2', 'faq.3', 'faq.4'] as const;
---
<section class="mx-auto grid max-w-7xl gap-10 px-5 py-20 md:grid-cols-12 md:px-8 md:py-28">
  <h2 class="font-serif text-4xl font-light md:col-span-4 md:text-5xl">{tr('faq.title')}</h2>
  <div class="md:col-span-7 md:col-start-6">
    {items.map((k) => (
      <details class="group border-b border-champagne/50 py-5 first:border-t">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-serif text-xl [&::-webkit-details-marker]:hidden">
          {tr(`${k}.q` as 'faq.1.q')}
          <svg viewBox="0 0 12 12" class="h-3 w-3 shrink-0 text-gold-deep transition-transform duration-300 group-open:rotate-45" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M6 0v12M0 6h12" /></svg>
        </summary>
        <p class="mt-4 max-w-xl leading-relaxed text-stone">{tr(`${k}.a` as 'faq.1.a')}</p>
      </details>
    ))}
  </div>
</section>
