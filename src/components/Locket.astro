---
import { s } from '../i18n/shop';
import type { Lang } from '../i18n/ui';
const { lang } = Astro.props as { lang: Lang };
const tr = s(lang);
const H = 'M100 215C50 175 20 140 20 104C20 78 40 62 62 62C80 62 94 72 100 86C106 72 120 62 138 62C160 62 180 78 180 104C180 140 150 175 100 215Z';
const inner = 'translate(100 140) scale(.84) translate(-100 -140)';
---
<div class="stage" data-locket data-open="false">
  <div class="glow" aria-hidden="true"></div>
  {['s1', 's2', 's3', 's4'].map((c) => (
    <svg class={`sp ${c}`} viewBox="0 0 10 10" aria-hidden="true"><path d="M5 0L6 4L10 5L6 6L5 10L4 6L0 5L4 4Z" /></svg>
  ))}

  <div class="locket">
    <div class="swing">
      <svg class="chain" viewBox="0 0 200 100" fill="none" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
        <defs><linearGradient id="chainfade" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="70"><stop offset="0" stop-color="#8a6a2f" stop-opacity="0" /><stop offset="1" stop-color="#8a6a2f" /></linearGradient></defs>
        <path d="M20 0L100 90M180 0L100 90" stroke="url(#chainfade)" stroke-dasharray="1.5 3" />
        <circle cx="100" cy="92" r="6" stroke="#8a6a2f" />
      </svg>

      <div class="body">
        <svg class="layer" viewBox="0 0 200 230" aria-hidden="true">
          <defs>
            <linearGradient id="gold" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#f6ead0" /><stop offset=".35" stop-color="#d9c08a" /><stop offset=".65" stop-color="#a8864a" /><stop offset="1" stop-color="#e6d3a3" /></linearGradient>
            <linearGradient id="photo" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f8f0e0" /><stop offset="1" stop-color="#e3d0a8" /></linearGradient>
            <linearGradient id="sheen" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#fff" stop-opacity="0" /><stop offset=".5" stop-color="#fff" stop-opacity=".6" /><stop offset="1" stop-color="#fff" stop-opacity="0" /></linearGradient>
            <clipPath id="hc"><path d={H} /></clipPath>
            <clipPath id="ic"><path d={H} transform={inner} /></clipPath>
          </defs>
          <path d={H} fill="url(#gold)" stroke="#8a6a2f" stroke-opacity=".5" stroke-width=".8" />
          <g clip-path="url(#ic)">
            <rect width="200" height="230" fill="url(#photo)" />
            <g fill="#b99a5f" fill-opacity=".55">
              <circle cx="82" cy="112" r="14" /><circle cx="121" cy="108" r="15" />
              <path d="M52 175Q82 124 112 175Z" /><path d="M88 178Q121 120 154 178Z" />
            </g>
          </g>
          <path d={H} transform={inner} fill="none" stroke="#8a6a2f" stroke-opacity=".6" stroke-width="1.2" />
        </svg>

        <div class="lid">
          <svg class="layer face front" viewBox="0 0 200 230" aria-hidden="true">
            <path d={H} fill="url(#gold)" stroke="#8a6a2f" stroke-opacity=".55" stroke-width=".8" />
            <path d={H} transform="translate(100 140) scale(.9) translate(-100 -140)" fill="none" stroke="#fff" stroke-opacity=".6" stroke-width="1.2" />
            <text x="100" y="146" text-anchor="middle" font-family="Cormorant Garamond Variable, Georgia, serif" font-size="58" font-weight="500" fill="#8a6a2f" fill-opacity=".8">V</text>
            <g clip-path="url(#hc)"><rect class="sweep" x="-60" y="0" width="50" height="230" fill="url(#sheen)" /></g>
          </svg>
          <svg class="layer face back" viewBox="0 0 200 230" aria-hidden="true">
            <path d={H} fill="url(#gold)" stroke="#8a6a2f" stroke-opacity=".5" stroke-width=".8" />
            <path d={H} transform={inner} fill="#f4e8cb" stroke="#8a6a2f" stroke-opacity=".5" stroke-width="1" />
          </svg>
        </div>
      </div>
    </div>
  </div>

  <button type="button" class="toggle" aria-pressed="false" aria-label={tr('locket.label')}></button>
  <p class="hint" aria-live="polite"><span class="h-closed">{tr('hint.closed')}</span><span class="h-open">{tr('hint.open')}</span></p>
</div>

<style>
  .stage { position: relative; display: grid; place-items: center; padding: 3rem 0 3rem; }
  .glow { position: absolute; inset: 4% 6%; border-radius: 9999px; background: radial-gradient(closest-side, rgba(205,180,131,.55), rgba(205,180,131,0)); filter: blur(24px); }
  .locket { position: relative; width: min(62vw, 290px); margin-top: 3.5rem; transition: transform 1.5s cubic-bezier(.2,.7,.2,1); }
  .stage[data-open="true"] .locket { transform: translateX(28%); }
  .swing { transform-origin: 50% 0; animation: sway 8s ease-in-out infinite; }
  .chain { position: absolute; left: 0; top: -5.2%; width: 100%; overflow: visible; }
  .body { position: relative; aspect-ratio: 200 / 230; perspective: 1300px; filter: drop-shadow(0 22px 28px rgba(138,106,47,.28)); }
  .layer { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .lid { position: absolute; inset: 0; transform-origin: 10% 50%; transform-style: preserve-3d; transition: transform 1.7s cubic-bezier(.65,0,.25,1); }
  .stage[data-open="true"] .lid { transform: rotateY(-165deg); }
  .face { backface-visibility: hidden; -webkit-backface-visibility: hidden; }
  .back { transform: rotateY(180deg); }
  .sweep { animation: sweep 6s ease-in-out 2s infinite; }
  .toggle { position: absolute; inset: 0; cursor: pointer; border-radius: 1rem; }
  .hint { position: relative; margin-top: 1.5rem; font-size: .875rem; color: #6f675e; min-height: 1.25rem; }
  .h-open { display: none; } .stage[data-open="true"] .h-open { display: inline; } .stage[data-open="true"] .h-closed { display: none; }
  .sp { position: absolute; width: 14px; fill: #cdb483; opacity: 0; animation: twinkle 3.6s ease-in-out infinite; }
  .s1 { top: 14%; left: 12%; } .s2 { top: 30%; right: 8%; animation-delay: 1.2s; width: 10px; }
  .s3 { bottom: 22%; left: 6%; animation-delay: 2.1s; width: 10px; } .s4 { bottom: 12%; right: 16%; animation-delay: .6s; }
  @keyframes sway { 0%, 100% { transform: rotate(-1.6deg); } 50% { transform: rotate(1.6deg); } }
  @keyframes sweep { 0% { transform: translateX(0) skewX(-18deg); } 45%, 100% { transform: translateX(330px) skewX(-18deg); } }
  @keyframes twinkle { 0%, 100% { opacity: 0; transform: scale(.5); } 50% { opacity: .9; transform: scale(1); } }
  @media (prefers-reduced-motion: reduce) {
    .locket, .lid { transition: none; } .swing, .sweep, .sp { animation: none; } .sp { opacity: .6; }
  }
</style>

<script>
  const stage = document.querySelector<HTMLElement>('[data-locket]');
  const btn = stage?.querySelector('button');
  if (stage && btn) {
    const set = (open: boolean) => { stage.dataset.open = String(open); btn.setAttribute('aria-pressed', String(open)); };
    btn.addEventListener('click', () => set(stage.dataset.open !== 'true'));
    // One orchestrated moment: the locket opens by itself once, then it is the visitor's to play with.
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) set(true);
    else setTimeout(() => set(true), 1300);
  }
</script>
