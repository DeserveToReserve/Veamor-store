---
import { t, basePath, type Lang } from '../i18n/ui';
const { lang } = Astro.props as { lang: Lang };
const tr = t(lang);
const base = basePath(lang);
---
<footer class="bg-linen">
  <div class="mx-auto grid max-w-7xl gap-12 px-5 py-16 md:grid-cols-12 md:px-8">
    <div class="md:col-span-5">
      <img src="/logo.webp" alt="Veamor – Jewelry &amp; Love" width="1200" height="574" class="h-28 w-auto" loading="lazy" decoding="async" />
      <p class="mt-4 max-w-sm leading-relaxed text-stone">{tr('footer.about')}</p>
    </div>
    <nav class="md:col-span-3 md:col-start-8" aria-label={tr('footer.shop')}>
      <h2 class="font-serif text-xl">{tr('footer.shop')}</h2>
      <ul class="mt-4 space-y-3 text-sm text-stone">
        <li><a class="hover:text-gold-deep" href={`${base}/#jewelry`}>{tr('nav.jewelry')}</a></li>
        <li><a class="hover:text-gold-deep" href={`${base}/#couples`}>{tr('nav.couples')}</a></li>
        <li><a class="hover:text-gold-deep" href={`${base}/#family`}>{tr('nav.family')}</a></li>
      </ul>
    </nav>
    <nav class="md:col-span-2" aria-label={tr('footer.help')}>
      <h2 class="font-serif text-xl">{tr('footer.help')}</h2>
      <ul class="mt-4 space-y-3 text-sm text-stone">
        <li><a class="hover:text-gold-deep" href="#">{tr('footer.delivery')}</a></li>
        <li><a class="hover:text-gold-deep" href="#">{tr('footer.returns')}</a></li>
        <li><a class="hover:text-gold-deep" href="#">{tr('footer.contact')}</a></li>
      </ul>
    </nav>
  </div>
  <div class="border-t border-champagne/50">
    <div class="mx-auto flex max-w-7xl flex-col gap-3 px-5 py-6 text-xs text-stone md:flex-row md:justify-between md:px-8">
      <p>© {new Date().getFullYear()} Veamor</p>
      <p>{tr('footer.secure')}</p>
      <p class="flex gap-5"><a class="hover:text-gold-deep" href="#">{tr('footer.privacy')}</a><a class="hover:text-gold-deep" href="#">{tr('footer.terms')}</a></p>
    </div>
  </div>
</footer>
