---
import { basePath, type Lang } from '../i18n/ui';
import { h } from '../i18n/home';
import Icon from './Icon.astro';
import ProductArt from './ProductArt';
const { lang, part } = Astro.props as { lang: Lang; part: 'occasions' | 'spotlight' | 'steps' | 'quote' };
const tr = h(lang); const base = basePath(lang);
const occ = ['occ.1', 'occ.2', 'occ.3', 'occ.4', 'occ.5'] as const;
const steps = [{ i: 'heart', k: 'how.1' }, { i: 'photo', k: 'how.2' }, { i: 'gift', k: 'how.3' }] as const;
---
{part === 'occasions' && (
  <section class="border-y border-champagne/40">
    <div class="mx-auto max-w-7xl px-5 py-16 text-center md:px-8 md:py-20">
      <h2 class="text-sm text-stone">{tr('occ.title')}</h2>
      <ul class="mt-8 flex flex-wrap items-center justify-center gap-x-7 gap-y-3 font-serif text-3xl font-light md:gap-x-10 md:text-5xl">
        {occ.map((o, i) => (
          <Fragment>
            {i > 0 && <li aria-hidden="true"><svg viewBox="0 0 10 10" class="h-2 w-2 fill-champagne"><path d="M5 0L10 5L5 10L0 5Z" /></svg></li>}
            <li>{tr(o)}</li>
          </Fragment>
        ))}
      </ul>
    </div>
  </section>
)}

{part === 'spotlight' && (
  <section class="mx-auto grid max-w-7xl items-center gap-12 px-5 py-20 md:grid-cols-12 md:gap-8 md:px-8 md:py-28">
    <div class="relative md:col-span-5">
      <div class="absolute -inset-4 rounded-t-full border border-champagne/50" aria-hidden="true"></div>
      <div class="relative flex aspect-[4/5] items-center justify-center rounded-t-full bg-gradient-to-b from-linen to-champagne/40" aria-hidden="true">
        <ProductArt kind="locket" className="h-3/5 w-3/5 text-gold-deep" />
      </div>
    </div>
    <div class="md:col-span-6 md:col-start-7">
      <h2 class="font-serif text-4xl font-light leading-tight md:text-6xl">{tr('spot.title')}</h2>
      <p class="mt-6 max-w-lg leading-relaxed text-stone">{tr('spot.text')}</p>
      <ul class="mt-8 space-y-4">
        {(['spot.1', 'spot.2', 'spot.3'] as const).map((k) => (
          <li class="flex items-center gap-4 text-sm"><Icon name="heart" class="h-5 w-5 text-gold-deep" />{tr(k)}</li>
        ))}
      </ul>
      <a href={`${base}/product/heart-locket/`} class="mt-10 inline-block bg-ink px-8 py-3.5 text-sm text-ivory transition-colors hover:bg-gold-deep">{tr('spot.cta')}</a>
    </div>
  </section>
)}

{part === 'steps' && (
  <section class="bg-linen/60">
    <div class="mx-auto max-w-7xl px-5 py-20 md:px-8 md:py-28">
      <h2 class="text-center font-serif text-4xl font-light md:text-5xl">{tr('how.title')}</h2>
      <ol class="relative mt-14 grid gap-12 md:grid-cols-3 md:gap-8">
        <div class="absolute left-[17%] right-[17%] top-8 hidden h-px bg-champagne md:block" aria-hidden="true"></div>
        {steps.map((st) => (
          <li class="relative text-center">
            <span class="mx-auto grid h-16 w-16 place-items-center rounded-full border border-champagne bg-ivory"><Icon name={st.i} class="h-7 w-7 text-gold-deep" /></span>
            <h3 class="mt-6 font-serif text-2xl">{tr(`${st.k}.t` as 'how.1.t')}</h3>
            <p class="mx-auto mt-3 max-w-xs text-sm leading-relaxed text-stone">{tr(`${st.k}.d` as 'how.1.d')}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
)}

{part === 'quote' && (
  <section class="relative overflow-hidden">
    <ProductArt kind="pair" className="pointer-events-none absolute -right-10 top-1/2 h-[120%] -translate-y-1/2 text-champagne/40" />
    <div class="relative mx-auto max-w-4xl px-5 py-24 text-center md:py-36">
      <p class="font-serif text-4xl font-light leading-snug md:text-6xl">{tr('quote')}</p>
      <p class="mt-8 font-serif text-xl text-gold-deep">Veamor</p>
    </div>
  </section>
)}
