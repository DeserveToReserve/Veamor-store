---
import { t, basePath, type Lang } from '../i18n/ui';
const { lang } = Astro.props as { lang: Lang };
const tr = t(lang);
const base = basePath(lang);
// Заглавието е на два реда: разделяме на последния интервал преди последните две думи.
const words = tr('hero.title').split(' ');
const cut = Math.ceil(words.length / 2);
const line1 = words.slice(0, cut).join(' ');
const line2 = words.slice(cut).join(' ');
---
<section class="relative isolate flex min-h-[41rem] items-start overflow-hidden bg-[#f1e7d6] md:min-h-[clamp(34rem,calc(100svh-8.5rem),54rem)] md:items-center">
  <!-- Фонът е по-широк от екрана и закотвен вляво: плочата остава под текста, медальонът е отдясно. -->
  <img src="/hero.webp" alt="" width="2576" height="1093" fetchpriority="high" decoding="async"
    class="absolute inset-y-0 left-0 -z-10 h-full w-full max-w-none object-cover object-[47%_100%] md:w-[128%] md:object-left" />

  <div class="mx-auto w-full max-w-7xl px-5 pb-16 pt-9 md:px-8 md:py-20">
    <div class="relative md:max-w-[52%] md:pl-4">
      <!-- Мек локален ореол само зад текста; преливa до пълна прозрачност в краищата -->
      <div class="pointer-events-none absolute -inset-x-8 -inset-y-14 -z-10 bg-[radial-gradient(closest-side,rgba(250,244,234,0.8)_0%,rgba(250,244,234,0.55)_50%,rgba(250,244,234,0)_100%)] md:-inset-x-24 md:-inset-y-20" aria-hidden="true"></div>
      <h1 class="rise d1 font-serif text-[clamp(2.4rem,11vw,3.25rem)] font-medium leading-[1.02] text-cocoa md:text-[clamp(3rem,4.5vw,4.9rem)]">
        <span class="block">{line1}</span><span class="block">{line2}</span>
      </h1>
      <p class="rise d2 mt-6 max-w-[22rem] leading-relaxed text-[#2c2522] md:mt-8 md:max-w-[25rem] md:text-[1.05rem]">{tr('hero.text')}</p>
      <div class="rise d3 mt-8 flex flex-wrap items-center gap-x-9 gap-y-4 md:mt-10">
        <a href={`${base}/#collections`} class="bg-cocoa px-8 py-4 text-[0.95rem] text-white transition-colors hover:bg-gold-deep md:px-9 md:py-[1.1rem]">{tr('hero.cta')}</a>
        <a href={`${base}/#couples`} class="border-b border-cocoa pb-1.5 text-[0.95rem] transition-colors hover:border-gold-deep hover:text-gold-deep">{tr('hero.cta2')}</a>
      </div>
    </div>
  </div>
</section>
