---
import { basePath, t, type Lang } from '../i18n/ui';
import { s } from '../i18n/shop';
import ProductArt from './ProductArt';
const { lang } = Astro.props as { lang: Lang };
const tr = s(lang); const nav = t(lang); const base = basePath(lang);
const tiles = [
  { id: 'jewelry', art: 'locket', title: nav('nav.jewelry'), text: tr('col.jewelry'), cls: 'md:col-span-7 md:row-span-2 min-h-[26rem] bg-gradient-to-br from-linen to-champagne/40', size: 'h-64 md:h-80' },
  { id: 'couples', art: 'infinity', title: nav('nav.couples'), text: tr('col.couples'), cls: 'md:col-span-5 min-h-[15rem] bg-gradient-to-br from-ivory to-linen', size: 'h-24 md:h-28' },
  { id: 'family', art: 'pair', title: nav('nav.family'), text: tr('col.family'), cls: 'md:col-span-5 min-h-[15rem] bg-gradient-to-br from-linen to-[#eddcd0]', size: 'h-24 md:h-28' },
] as const;
---
<section id="collections" class="mx-auto max-w-7xl scroll-mt-24 px-5 py-20 md:px-8 md:py-28">
  <div class="max-w-xl">
    <h2 class="font-serif text-4xl font-light md:text-5xl">{tr('col.title')}</h2>
    <p class="mt-4 text-stone">{tr('col.sub')}</p>
  </div>
  <div class="mt-12 grid gap-4 md:grid-cols-12 md:gap-6">
    {tiles.map((c) => (
      <a href={`${base}/#${c.id}`} class={`group relative flex flex-col justify-end overflow-hidden p-6 md:p-8 ${c.cls}`}>
        <ProductArt kind={c.art} className={`absolute right-6 top-6 ${c.size} text-gold-deep/80 transition-transform duration-700 group-hover:scale-105 md:right-10 md:top-10`} />
        <h3 class="font-serif text-3xl">{c.title}</h3>
        <p class="mt-2 max-w-xs text-sm leading-relaxed text-stone">{c.text}</p>
        <span class="mt-5 w-fit text-sm underline decoration-champagne underline-offset-8 group-hover:text-gold-deep">{tr('col.view')}</span>
      </a>
    ))}
  </div>
</section>
