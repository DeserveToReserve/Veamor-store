---
import { basePath, t, type Lang } from '../i18n/ui';
import { s } from '../i18n/shop';
import ProductArt from './ProductArt';
const { lang } = Astro.props as { lang: Lang };
const tr = s(lang); const nav = t(lang); const base = basePath(lang);
const tiles = [
  { id: 'jewelry', art: 'locket', title: nav('nav.jewelry'), text: tr('col.jewelry'), cls: 'md:col-span-7 md:row-span-2 min-h-[26rem] bg-ink', size: 'h-64 md:h-80', photo: '/jewelry-tile.webp', pos: 'object-[50%_58%] brightness-[0.62]', tw: 'max-w-xs', ov: 'bg-gradient-to-t from-black/60 via-black/10 to-transparent group-hover:opacity-70 group-focus-visible:opacity-70', hov: 'group-hover:brightness-100 group-focus-visible:brightness-100' },
  { id: 'couples', art: 'infinity', title: nav('nav.couples'), text: tr('col.couples'), cls: 'md:col-span-5 min-h-[22rem] md:min-h-[15rem] bg-ink', size: 'h-24 md:h-28', photo: '/couples-tile.webp', pos: 'object-[46%_50%] brightness-[0.55] md:w-[136%] md:max-w-none md:object-[50%_12%]', tw: 'max-w-xs md:max-w-[15rem]', ov: 'bg-gradient-to-r from-black/70 via-black/40 to-black/5', hov: 'group-hover:brightness-[0.85] group-focus-visible:brightness-[0.85]' },
  { id: 'family', art: 'pair', title: nav('nav.family'), text: tr('col.family'), cls: 'md:col-span-5 min-h-[15rem] bg-gradient-to-br from-linen to-[#eddcd0]', size: 'h-24 md:h-28', photo: '', pos: '', tw: 'max-w-xs', ov: '', hov: '' },
] as const;
---
<section id="collections" class="mx-auto max-w-7xl scroll-mt-24 px-5 py-20 md:px-8 md:py-28">
  <div class="max-w-xl">
    <h2 class="font-serif text-4xl font-light md:text-5xl">{tr('col.title')}</h2>
    <p class="mt-4 text-stone">{tr('col.sub')}</p>
  </div>
  <div class="mt-12 grid gap-4 md:grid-cols-12 md:gap-6">
    {tiles.map((c) => (
      <a href={`${base}/#${c.id}`} class={`group relative flex flex-col justify-end overflow-hidden p-6 md:p-8 ${c.cls}`}>
        {c.photo ? (
          <>
            <img src={c.photo} alt="" width="1400" height="1400" loading="lazy" decoding="async"
              class={`absolute inset-0 h-full w-full object-cover ${c.pos} saturate-[0.9] transition duration-700 ease-out group-hover:scale-[1.06] group-hover:saturate-100 group-focus-visible:scale-[1.06] ${c.hov} motion-reduce:transition-none motion-reduce:group-hover:scale-100`} />
            <div class={`pointer-events-none absolute inset-0 transition-opacity duration-700 ${c.ov}`} aria-hidden="true"></div>
          </>
        ) : (
          <ProductArt kind={c.art} className={`absolute right-6 top-6 ${c.size} text-gold-deep/80 transition-transform duration-700 group-hover:scale-105 md:right-10 md:top-10`} />
        )}
        <div class={`relative origin-bottom-left transition-transform duration-700 ease-out ${c.photo ? 'drop-shadow-[0_1px_10px_rgba(0,0,0,0.5)] group-hover:scale-[0.92] group-focus-visible:scale-[0.92] motion-reduce:transition-none motion-reduce:group-hover:scale-100' : ''}`}>
          <h3 class={`font-serif text-3xl ${c.photo ? 'text-white' : ''}`}>{c.title}</h3>
          <p class={`mt-2 ${c.tw} text-sm leading-relaxed ${c.photo ? 'text-white/85' : 'text-stone'}`}>{c.text}</p>
          <span class={`mt-5 block w-fit text-sm underline underline-offset-8 ${c.photo ? 'decoration-white/60 text-white' : 'decoration-champagne group-hover:text-gold-deep'}`}>{tr('col.view')}</span>
        </div>
      </a>
    ))}
  </div>
</section>
