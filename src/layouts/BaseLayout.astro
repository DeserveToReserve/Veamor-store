---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TrustBar from '../components/TrustBar.astro';
import CartDrawer from '../components/CartDrawer';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang; title?: string; description?: string; noindex?: boolean }
const { lang, title = 'Veamor', description, noindex = false } = Astro.props;
const desc = description ?? (lang === 'bg'
  ? 'Veamor – персонализирани подаръци и бижута: медальони, гривни за двойки и колиета за майка и дъщеря.'
  : 'Veamor – personalized gifts and jewelry: lockets, couples bracelets and mother-daughter necklaces.');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fbf8f3" />
    <meta name="description" content={desc} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="alternate" hreflang="bg" href="/" />
    <link rel="alternate" hreflang="en" href="/en/" />
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col">
    <TrustBar variant="top" lang={lang} />
    <Header lang={lang} />
    <main class="flex-1 pb-20"><slot /></main>
    <TrustBar variant="bottom" lang={lang} />
    <Footer lang={lang} />
    <CartDrawer client:load lang={lang} />
  </body>
</html>
