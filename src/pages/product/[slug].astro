---
import { products } from '../../data/products';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductPage from '../../components/ProductPage.astro';

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}
const { product } = Astro.props;
---
<BaseLayout lang="bg" title={`${product.name.bg} – Veamor`}><ProductPage lang="bg" product={product} /></BaseLayout>
